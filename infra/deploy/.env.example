# infra/deploy/.env  —  bu dosyayı .env olarak kopyalayıp doldurun (git'e GİRMEZ).
# Parolalar güçlü olmalı; bunlar örnektir.

# MSSQL sa parolası (güçlü: 8+ karakter, büyük/küçük/rakam/sembol).
SA_PAROLA=Kds!Degistir-Beni-2026

# Keycloak yönetici (ilk açılışta oluşturulur).
KC_ADMIN=admin
KC_ADMIN_PAROLA=Kc!Degistir-Beni-2026

# Tarayıcının erişeceği PUBLIC adresler. Tek-VM'de host localhost'tur; gerçek sunucuda
# sunucunun IP/domain'i (ör. http://10.0.0.5 ya da https://kds.sirket.com) yazın.
PUBLIC_KEYCLOAK=http://localhost:8080
PUBLIC_API=http://localhost:5210
PUBLIC_ONYUZ=http://localhost:5173
