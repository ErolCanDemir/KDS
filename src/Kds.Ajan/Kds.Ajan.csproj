  </PropertyGroup>

  <ItemGroup>
    <!-- Yalnız iki iç referans: protokol DTO'ları (Contracts) ve veri kodlaması + SqlClient
         (Execution). Kds.Data/Business BİLEREK yok — ajan, KDS'nin iç modeline bağlanmaz. -->
    <ProjectReference Include="..\Kds.Contracts\Kds.Contracts.csproj" />
    <ProjectReference Include="..\Kds.Execution\Kds.Execution.csproj" />
  </ItemGroup>

</Project>
