<?xml version="1.0" encoding="utf-8"?>
<!-- Yalnız nuget.org: makinedeki global config'te VPN isteyen şirket feed'i var
     (SQLST'deki aynı önlem) — restore ona takılmasın. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
